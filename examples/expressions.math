// MVP 1: expressions, exact arithmetic, simplification and substitution.
variable x : Real
variable y : Real
parameter a : Real

f = 2*x + 3*x
print(f)                         // 2*x + 3*x
print(simplify(f))               // 5*x

g = (x + 1)^3
print(simplify(g))               // (x + 1)^3
print(normalize(g))              // x^3 + 3*x^2 + 3*x + 1
print(normalize(1/2 + 1/3))      // 5/6

print(simplify(sin(x)^2 + cos(x)^2))  // 1

value = (x + y)^2
    |> substitute(x = 2, y = 3)
    |> normalize
print(value)                     // 25

result = (a*x + y) where {
    x = 2
    y = 3
    a = 4
}
print(result |> normalize)       // 11

// Substitutions are simultaneous and leave declarations unchanged.
print(x-y where {x=y; y=x})      // y - x

square(t) = normalize(t^2 + 2*t + 1)
print(square(2))                 // 9

// No assumptions about x being nonzero are made.
print(simplify(x/x))             // x/x
